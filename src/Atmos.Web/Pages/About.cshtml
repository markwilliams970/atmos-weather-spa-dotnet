@page
@model AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["HideWeatherPanels"] = true;
}

<div class="about-card">
  <h2>About Atmos</h2>
  <p>
    Atmos is a weather application built around free, keyless public data
    sources — search by ZIP code or city, drop a pin anywhere on the map, and
    get a current/24-hour/7-day forecast, air quality, and live radar for
    that spot.
  </p>
  <p>
    This is the ASP.NET Core / SQL Server modernization of the original
    Atmos Weather single-page app.
  </p>
</div>

<div class="about-card">
  <h2>Data sources</h2>
  <ul>
    <li><a href="https://open-meteo.com" target="_blank" rel="noopener">Open-Meteo</a> — forecast, geocoding, air quality, elevation</li>
    <li><a href="https://www.zippopotam.us" target="_blank" rel="noopener">Zippopotam.us</a> — ZIP code lookup</li>
    <li><a href="https://www.rainviewer.com" target="_blank" rel="noopener">RainViewer</a> — radar imagery</li>
    <li><a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> / Overpass / Nominatim — nearby-place labeling</li>
    <li><a href="https://carto.com/basemaps" target="_blank" rel="noopener">CARTO</a> — dark basemap tiles</li>
  </ul>
</div>
